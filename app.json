{
  "expo": {
    "name": "DualCam",
    "slug": "DualCam",
    "scheme": "dualcam",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.burakarslan.dualcam",
      "appleTeamId": "5BF7PPQH95",
      "infoPlist": {
        "NSCameraUsageDescription": "DualCam uses the front and back cameras to record videos and take photos.",
        "NSMicrophoneUsageDescription": "DualCam records sound with your videos. Without access, videos are saved without sound.",
        "NSPhotoLibraryAddUsageDescription": "DualCam saves your videos and photos to your library.",
        "UIRequiresFullScreen": true,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "tr"
            ]
          }
        }
      ],
      "expo-sqlite"
    ],
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    }
  }
}
